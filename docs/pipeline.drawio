<mxfile host="app.diagrams.net"><diagram id="pipeline" name="Pipeline"><mxGraphModel dx="1700" dy="900" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="scene" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Analytic Scene&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;z = f(x, y)&lt;br&gt;p = ∂z/∂x, q = ∂z/∂y&lt;br&gt;n = (−p, −q, 1)/‖·‖&lt;br&gt;albedo ρ(x, y)&lt;br&gt;&lt;br&gt;&lt;i&gt;sphere · gaussian&lt;br&gt;peaks · ripple&lt;/i&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#E3F1E6;strokeColor=#3A9D5D;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="210" height="250" as="geometry"/></mxCell><mxCell id="fwd" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Forward Models Φ&lt;/b&gt;" style="rounded=1;arcSize=4;verticalAlign=top;spacingTop=8;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#ECEFF4;strokeColor=#5B6B82;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="280" y="150" width="240" height="560" as="geometry"/></mxCell><mxCell id="lamb" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Lambertian shading&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;I&lt;sub&gt;k&lt;/sub&gt; = ρ max(0, n·s&lt;sub&gt;k&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8A97AB;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="295" y="195" width="210" height="80" as="geometry"/></mxCell><mxCell id="defoc" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Thin-lens defocus&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;σ(Z) ∝ (Av/2)|1/F − 1/v − 1/Z|&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8A97AB;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="295" y="290" width="210" height="80" as="geometry"/></mxCell><mxCell id="pin" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Pinhole projection&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;x ~ K [R | t] X  ·  ray casting&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8A97AB;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="295" y="385" width="210" height="80" as="geometry"/></mxCell><mxCell id="warp" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Exact motion warp&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;I&lt;sub&gt;2&lt;/sub&gt;(x + w(x)) = I&lt;sub&gt;1&lt;/sub&gt;(x)&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8A97AB;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="295" y="480" width="210" height="80" as="geometry"/></mxCell><mxCell id="noise" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Sensor model&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;+ N(0, σ²) · 8-bit quantisation&lt;br&gt;&lt;i&gt;applied to every image&lt;/i&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;dashed=1;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8A97AB;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="295" y="600" width="210" height="90" as="geometry"/></mxCell><mxCell id="lane1" value="&lt;b&gt;Single viewpoint  ·  Course 3&lt;/b&gt;" style="swimlane;horizontal=1;startSize=30;rounded=1;arcSize=4;fontSize=13;swimlaneFillColor=#EAF3FA;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#EAF3FA;strokeColor=#2A6F97;fontColor=#1F2933;fillColor=#2A6F97;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="510" height="370" as="geometry"/></mxCell><mxCell id="ps" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Photometric Stereo&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;g = (SᵀS)⁻¹SᵀI&lt;br&gt;ρ = ‖g‖,  n = g/ρ&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2A6F97;fontColor=#1F2933;" vertex="1" parent="lane1"><mxGeometry x="30" y="50" width="200" height="90" as="geometry"/></mxCell><mxCell id="integ" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Normal Integration&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Poisson: ∇²z = p&lt;sub&gt;x&lt;/sub&gt; + q&lt;sub&gt;y&lt;/sub&gt;&lt;br&gt;Frankot–Chellappa (FFT)&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2A6F97;fontColor=#1F2933;" vertex="1" parent="lane1"><mxGeometry x="280" y="50" width="210" height="90" as="geometry"/></mxCell><mxCell id="sfs" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Shape from Shading&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;min Σ(E − R(p,q))²&lt;br&gt;+ λ(‖∇p‖² + ‖∇q‖²)&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2A6F97;fontColor=#1F2933;" vertex="1" parent="lane1"><mxGeometry x="30" y="160" width="200" height="90" as="geometry"/></mxCell><mxCell id="dfd" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Depth from Defocus&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;σ₁² − σ₂² = 2(g₁ − g₂)/∇²g&lt;br&gt;→ Z by thin-lens lookup&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2A6F97;fontColor=#1F2933;" vertex="1" parent="lane1"><mxGeometry x="30" y="265" width="200" height="90" as="geometry"/></mxCell><mxCell id="lane2" value="&lt;b&gt;Multiple viewpoints  ·  Course 4&lt;/b&gt;" style="swimlane;horizontal=1;startSize=30;rounded=1;arcSize=4;fontSize=13;swimlaneFillColor=#FDF1E6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FDF1E6;strokeColor=#C76A1A;fontColor=#1F2933;fillColor=#C76A1A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="560" y="440" width="510" height="420" as="geometry"/></mxCell><mxCell id="calib" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Camera Calibration&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;DLT  Ap = 0 → RQ → LM&lt;br&gt;K, R, t&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C76A1A;fontColor=#1F2933;" vertex="1" parent="lane2"><mxGeometry x="30" y="55" width="200" height="90" as="geometry"/></mxCell><mxCell id="stereo" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Rectified Stereo&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;SSD block match&lt;br&gt;Z = f b / d&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C76A1A;fontColor=#1F2933;" vertex="1" parent="lane2"><mxGeometry x="280" y="55" width="210" height="90" as="geometry"/></mxCell><mxCell id="epi" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Uncalibrated Stereo&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;x₂ᵀ F x₁ = 0  (8-point)&lt;br&gt;E = KᵀFK → R, t&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C76A1A;fontColor=#1F2933;" vertex="1" parent="lane2"><mxGeometry x="30" y="165" width="200" height="90" as="geometry"/></mxCell><mxCell id="tri" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Triangulation&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;linear DLT&lt;br&gt;→ sparse metric 3D points&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C76A1A;fontColor=#1F2933;" vertex="1" parent="lane2"><mxGeometry x="280" y="165" width="210" height="90" as="geometry"/></mxCell><mxCell id="flow" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Optical Flow&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;I&lt;sub&gt;x&lt;/sub&gt;u + I&lt;sub&gt;y&lt;/sub&gt;v + I&lt;sub&gt;t&lt;/sub&gt; = 0&lt;br&gt;Lucas–Kanade · Horn–Schunck&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C76A1A;fontColor=#1F2933;" vertex="1" parent="lane2"><mxGeometry x="30" y="275" width="200" height="90" as="geometry"/></mxCell><mxCell id="sfm" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Structure from Motion&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;W = M S  (rank 3)&lt;br&gt;metric upgrade QQᵀ&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C76A1A;fontColor=#1F2933;" vertex="1" parent="lane2"><mxGeometry x="280" y="275" width="210" height="90" as="geometry"/></mxCell><mxCell id="fuse" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Photo-Geometric Fusion&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;min ‖A&lt;sub&gt;n&lt;/sub&gt;z − b&lt;sub&gt;n&lt;/sub&gt;‖² + λ²‖A&lt;sub&gt;p&lt;/sub&gt;z − ẑ‖²&lt;br&gt;&lt;br&gt;normals → high frequencies&lt;br&gt;points → scale + low frequencies&lt;br&gt;λ by hold-out validation&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#F1EAF8;strokeColor=#7D5BA6;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1130" y="345" width="240" height="175" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Evaluation&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;angular error · depth RMS&lt;br&gt;reprojection · EPE&lt;br&gt;pose / shape error&lt;br&gt;&lt;br&gt;Monte Carlo ≥ 100 trials&lt;br&gt;noise · lights · baseline sweeps&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#E6F4F1;strokeColor=#1F7A6D;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1430" y="240" width="240" height="240" as="geometry"/></mxCell><mxCell id="out" value="&lt;b style=&#x27;font-size:12px&#x27;&gt;Outputs&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;fig01 – fig15 · *.json&lt;br&gt;summary.md (O1 – O8)&lt;br&gt;report · slides&lt;/span&gt;" style="rounded=1;arcSize=8;verticalAlign=middle;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=Helvetica;fillColor=#F4F4F4;strokeColor=#777777;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="1430" y="580" width="240" height="120" as="geometry"/></mxCell><mxCell id="e1" value="{I&lt;sub&gt;k&lt;/sub&gt;}, S" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3C4858;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lamb" target="ps"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="219"/><mxPoint x="545" y="135"/></Array></mxGeometry></mxCell><mxCell id="e2" value="E, s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#3C4858;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lamb" target="sfs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>